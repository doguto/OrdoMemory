<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity (netstandard2.1 / C# 9) 相当の条件でサンプルをコンパイルする -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OrdoMemory.Design</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Benchmark が、比較用テーブルから SampleSchema.Id を設定するため -->
    <InternalsVisibleTo Include="RuntimeTableBenchmark" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MasterMemory" Version="3.0.4" />
    <PackageReference Include="MessagePack" Version="3.1.11" />
  </ItemGroup>

</Project>
